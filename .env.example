# Set fallback for curated hints without an LLM account; anthropic for generated hints.
LLM_PROVIDER=fallback
ANTHROPIC_API_KEY=

# Defaults to the five bundled public examples. Mount ONLY accepted runtime questions.
INTERVIEW_MCP_PROBLEMS_DIR=

# Directory for the SQLite database file. Defaults to ~/.interview-mcp/
INTERVIEW_MCP_DB_DIR=

INTERVIEW_MCP_MODE=local
PISTON_BASE_URL=http://localhost:2000
INTERVIEW_MCP_PYTHON_VERSION=3.12.0
# Remote: set to your public hostname plus localhost,127.0.0.1 for internal probes.
INTERVIEW_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional browser clients; comma-separated exact origins. No Origin header is allowed by default.
INTERVIEW_MCP_ALLOWED_ORIGINS=
