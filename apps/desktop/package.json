{
  "name": "interview-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first interview practice desktop workspace with an MCP-connected AI coach",
  "author": "Armand Syah",
  "homepage": "https://github.com/ArmandSyah/interview-mcp",
  "desktopName": "interview-workbench.desktop",
  "license": "Apache-2.0",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "install:electron": "node node_modules/electron/install.js",
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "playwright test",
    "start": "electron .",
    "backend": "node scripts/build-backend.mjs",
    "package": "npm run backend && npm run build && electron-builder --dir",
    "dist": "npm run backend && npm run build && electron-builder",
    "format": "prettier --write src scripts tests *.json *.ts *.html",
    "format:check": "prettier --check src scripts tests *.json *.ts *.html"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "lucide-react": "^0.577.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.3",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "io.github.armandsyah.interview-workbench",
    "productName": "Interview Workbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "asar": true,
    "linux": {
      "maintainer": "Armand Syahtama <armand.syahtama@gmail.com>",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
